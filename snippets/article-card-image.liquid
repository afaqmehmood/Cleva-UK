{% liquid
  assign class = class | append: ' w-full aspect-[4/3] object-cover transition-transform group-hover:scale-110 group-focus-within:scale-110'

  assign width = 2000

  assign widths = '294, 398, 588, 796, 882'
%}

{% capture sizes %}
  (min-width: 768px) calc(33vw - 44px),
  calc(100vw - 32px)
{% endcapture %}

{% assign sizes = sizes | strip_newlines | strip %}

{{ image | image_url: width: width | image_tag: class: class, loading: loading, widths: widths, sizes: sizes }}
