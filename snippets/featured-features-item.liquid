{% liquid
  assign image = block.settings.image | default: null

  assign image_loading = block.settings.image_loading | default: null

  assign icon = block.settings.icon | default: null

  assign title = block.settings.title | default: null

  assign text = block.settings.text | default: null
%}

<div
  class="
    flex

    {% if index0 == 0 %}
      md:py-12 md:bg-grey-50 md:rounded-2xl main-grid md:!grid-cols-6
    {% else %}
      max-md:snap-start max-md:shrink-0 max-md:w-11/12
    {% endif %}
  "
>
  <div
    class="
      col-span-full md:col-start-2 md:col-span-4 flex

      {% if index0 == 0 %}
        flex-col row-span-3 gap-y-6 md:gap-y-12
      {% else %}
        flex-row-reverse items-start gap-x-10
      {% endif %}
    "
  >
    <div class="flex-1">
      {% if title %}
        <div
          class="
            flex gap-x-4 last:mb-0
          
            {% if index0 == 0 %}
              text-[24px]/[30px] md:text-[33px]/[35px] font-bold mb-6
              [&_svg]:translate-y-1 md:[&_svg]:translate-y-1.5
            {% else %}
              text-[20px] mb-4 [&_svg]:translate-y-0.5
            {% endif %}
          "
        >
          {% if icon %}
            {% render 'svg', name: icon, class: 'text-[24px]' %}
          {% endif %}
        
          <h3>
            {{ title }}
          </h3>
        </div>
      {% endif %}

      {% if text %}
        {%
          render 'text-truncate',
          text: text,
          truncate_enable: true,
          class: 'md:text-[20px] text-grey-300',
          text_class: 'space-y-4'
        %}
      {% endif %}
    </div>

    {% if image %}
      <div
        class="
          overflow-hidden

          {% if index0 == 0 %}
            rounded-2xl
          {% else %}
            max-md:hidden shrink-0 w-[22%] rounded-lg
          {% endif %}
        "
      >
        {% render 'featured-features-image', image: image, loading: image_loading, index0: index0 %}
      </div>
    {% endif %}
  </div>
</div>

