{% form 'customer_address', customer.new_address, aria-labelledBy: 'AddressNewHeading', class: 'text-left' %}
  <h2 class="font-bold text-[20px]/[25px] text-center mb-6" id="AddressNewHeading">
    {{ 'customer.addresses.add_new' | t }}
  </h2>

  <label class="sr-only" for="AddressFirstNameNew">
    {{ 'customer.addresses.first_name' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="text"
    id="AddressFirstNameNew"
    name="address[first_name]"
    value="{{ form.first_name }}"
    autocomplete="given-name"
    placeholder="{{ 'customer.addresses.first_name' | t }}"
  >

  <label class="sr-only" for="AddressLastNameNew">
    {{ 'customer.addresses.last_name' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="text"
    id="AddressLastNameNew"
    name="address[last_name]"
    value="{{ form.last_name }}"
    autocomplete="family-name"
    placeholder="{{ 'customer.addresses.last_name' | t }}"
  >

  <label class="sr-only" for="AddressCompanyNew">
    {{ 'customer.addresses.company' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="text"
    id="AddressCompanyNew"
    name="address[company]"
    value="{{ form.company }}"
    autocomplete="organization"
    placeholder="{{ 'customer.addresses.company' | t }}"
  >

  <label class="sr-only" for="AddressAddress1New">
    {{ 'customer.addresses.address1' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="text"
    id="AddressAddress1New"
    name="address[address1]"
    value="{{ form.address1 }}"
    autocomplete="address-line1"
    placeholder="{{ 'customer.addresses.address1' | t }}"
  >

  <label class="sr-only" for="AddressAddress2New">
    {{ 'customer.addresses.address2' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="text"
    id="AddressAddress2New"
    name="address[address2]"
    value="{{ form.address2 }}"
    autocomplete="address-line2"
    placeholder="{{ 'customer.addresses.address2' | t }}"
  >

  <label class="sr-only" for="AddressCityNew">
    {{ 'customer.addresses.city' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="text"
    id="AddressCityNew"
    name="address[city]"
    value="{{ form.city }}"
    autocomplete="address-level2"
    placeholder="{{ 'customer.addresses.city' | t }}"
  >

  <div class="mb-6">
    <label class="sr-only" for="AddressCountryNew">
      {{ 'customer.addresses.country' | t }}
    </label>
    
    <select
      class="form-select"
      id="AddressCountryNew"
      name="address[country]"
      data-default="{{ form.country }}"
      autocomplete="country"
    >
      {{ all_country_option_tags }}
    </select>
  </div>

  <div class="mb-6" id="AddressProvinceContainerNew" style="display: none">
    <label class="sr-only" for="AddressProvinceNew">
      {{ 'customer.addresses.province' | t }}
    </label>

    <select
      class="form-select"
      id="AddressProvinceNew"
      name="address[province]"
      data-default="{{ form.province }}"
      autocomplete="address-level1"
    ></select>
  </div>

  <label class="sr-only" for="AddressZipNew">
    {{ 'customer.addresses.zip' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="text"
    id="AddressZipNew"
    name="address[zip]"
    value="{{ form.zip }}"
    autocapitalize="characters"
    autocomplete="postal-code"
    placeholder="{{ 'customer.addresses.zip' | t }}"
  >

  <label class="sr-only" for="AddressPhoneNew">
    {{ 'customer.addresses.phone' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="tel"
    id="AddressPhoneNew"
    name="address[phone]"
    value="{{ form.phone }}"
    autocomplete="tel"
    placeholder="{{ 'customer.addresses.phone' | t }}"
  >

  <div class="flex gap-x-3 mb-6">
    {{ form.set_as_default_checkbox | replace: '<input', '<input class="form-checkbox"' }}

    <label class="font-bold text-[13px]/none text-grey-100" for="address_default_address_new">
      {{ 'customer.addresses.set_default' | t }}
    </label>
  </div>

  <button class="form-button form-button--black w-full mb-6" type="submit">
    {{ 'customer.addresses.add' | t }}
  </button>

  <div class="text-center">
    <button class="group/button inline-flex items-center gap-x-4" type="reset">
      {{ 'customer.addresses.cancel' | t }}

      {% render 'svg', name: 'arrow', class: 'group-hover/button:translate-x-1 transition text-[14px]' %}
    </button>
  </div>
{% endform %}
