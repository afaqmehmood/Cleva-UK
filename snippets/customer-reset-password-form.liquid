{% form 'reset_customer_password' %}
  <h1 class="font-bold text-[33px]/[50px] md:text-[40px]/[48px] text-center mb-6">
    {{ 'customer.reset_password.title' | t }}
  </h1>

  <p class="text-grey-300 mb-6">
    {{ 'customer.reset_password.text' | t }}
  </p>

  {% if form.errors %}
    {% render 'form-errors', form: form %}
  {% endif %}

  <label class="sr-only" for="password">
    {{ 'customer.reset_password.password' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="password"
    name="customer[password]"
    id="password"
    autocomplete="new-password"
    placeholder="{{ 'customer.reset_password.password' | t }}"
    required

    {% if form.errors contains 'password' %}
      aria-invalid="true"
    {% endif %}
  >

  <label class="sr-only" for="password_confirmation">
    {{ 'customer.reset_password.password_confirm' | t }}
  </label>

  <input  
    class="form-input mb-6"
    type="password"
    name="customer[password_confirmation]"
    id="password_confirmation"
    autocomplete="new-password"
    placeholder="{{ 'customer.reset_password.password_confirm' | t }}"
    required

    {% if form.errors contains 'password_confirmation' %}
      aria-invalid="true"
    {% endif %}
  >

  <button class="form-button form-button--black w-full" type="submit">
    {{ 'customer.reset_password.submit' | t }}
  </button>
{% endform %}
