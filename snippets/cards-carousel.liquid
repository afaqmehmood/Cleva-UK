<div
  class="col-span-full relative pt-24 md:pt-12 {{ class }}"
  x-data="carousel"
  tabindex="0"
  role="region"
  @keydown.right="next"
  @keydown.left="prev"
>
  {% render 'carousel-arrows', is_circle: true, class: 'absolute max-md:top-8 md:bottom-full right-0' %}

  <ul
    class="
      overflow-x-scroll snap-x snap-mandatory scrollbar-none
      max-md:-mx-[--container-padding-x] max-md:px-[--container-padding-x]
      flex -ml-4 [&_>_*]:pl-4 md:-ml-6 md:[&_>_*]:pl-6

      {% case slides_gap %}
        {% when 5 %}
          xl:-ml-5 xl:[&_>_*]:pl-5
        {% when 12 %}
          xl:-ml-12 xl:[&_>_*]:pl-12
        {% when 14 %}
          xl:-ml-14 xl:[&_>_*]:pl-14
      {% endcase %}
    "
    style="
      --columns: 1.11;
      --md-columns: {{ slides_columns }};
    "
    tabindex="0"
    role="listbox"
    x-ref="slider"
  >
    {{ slides_content }}
  </ul>
</div>
