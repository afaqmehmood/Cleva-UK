<form class="relative" action="{{ routes.search_url }}" role="search">
  <!-- <input type="hidden" name="type" value="product"> -->

  <label class="sr-only" for="{{ input_id }}">
    {{ 'header.search' | t }}
  </label>

  <input
    class="form-input py-2 pl-4 pr-11 bg-grey-50 rounded-full"
    type="search"
    name="q"
    id="{{ input_id }}"
    value="{{ search.terms | escape }}"
    placeholder="{{ 'header.search' | t }}"
    x-ref="input"
  >

  <button id="header-search-form" class="absolute top-1/2 -translate-y-1/2 p-4 right-0 my-auto" type="submit">
    {% render 'svg', name: 'search', class: 'text-[14px]' %}

    <span class="sr-only">
      {{ 'header.search' | t }}
    </span>
  </button>
</form>
