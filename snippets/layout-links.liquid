<link rel="canonical" href="{{ canonical_url }}">

<link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

{{ 'font-manrope-500.woff2' | asset_url | preload_tag: as: 'font', crossorigin: true }}
{{ 'font-manrope-700.woff2' | asset_url | preload_tag: as: 'font', crossorigin: true }}
{{ 'font-manrope-800.woff2' | asset_url | preload_tag: as: 'font', crossorigin: true }}

{% if settings.favicon_image %}
  <link rel="icon" type="image/png" href="{{ settings.favicon_image | image_url: width: 32, height: 32 }}">
{% endif %}

{% if settings.mode == 'development' %}
  <link rel="stylesheet" href="{{ 'main.min.css' | asset_url }}">
{% else %}
  <style>
    {% render 'css-main.min.css' %}
  </style>
{% endif %}

{% if template.directory == 'customers' %}
  <link rel="stylesheet" href="{{ 'customer.css' | asset_url }}">
{% endif %}
