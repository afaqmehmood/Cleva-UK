{% form 'create_customer' %}
  <h1 class="font-bold text-[33px]/[50px] md:text-[40px]/[48px] text-center mb-6">
    {{ 'customer.register.title' | t }}
  </h1>

  {% if form.errors %}
    {% render 'form-errors', form: form %}
  {% endif %}

  <label class="sr-only" for="RegisterForm-FirstName">
    {{ 'customer.register.first_name' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="text"
    name="customer[first_name]"
    id="RegisterForm-FirstName"
    autocomplete="given-name"
    placeholder="{{ 'customer.register.first_name' | t }}"
    required

    {% if form.first_name %}
      value="{{ form.first_name }}"
    {% endif %}
  >

  <label class="sr-only" for="RegisterForm-LastName">
    {{ 'customer.register.last_name' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="text"
    name="customer[last_name]"
    id="RegisterForm-LastName"
    autocomplete="family-name"
    placeholder="{{ 'customer.register.last_name' | t }}"
    required

    {% if form.last_name %}
      value="{{ form.last_name }}"
    {% endif %}
  >

  <label class="sr-only" for="RegisterForm-email">
    {{ 'customer.register.email' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="email"
    name="customer[email]"
    id="RegisterForm-email"
    spellcheck="false"
    autocapitalize="off"
    autocomplete="email"
    aria-required="true"
    placeholder="{{ 'customer.register.email' | t }}"
    required

    {% if form.email %}
      value="{{ form.email }}"
    {% endif %}

    {% if form.errors contains 'email' %}
      aria-invalid="true"
    {% endif %}
  >

  <label class="sr-only" for="RegisterForm-password">
    {{ 'customer.register.password' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="password"
    name="customer[password]"
    id="RegisterForm-password"
    aria-required="true"
    placeholder="{{ 'customer.register.password' | t }}"
    required

    {% if form.errors contains 'password' %}
      aria-invalid="true"
    {% endif %}
  >

  <button id="register-form-submit" class="form-button form-button--black w-full" type="submit">
    {{ 'customer.register.submit' | t }}
  </button>
{% endform %}
