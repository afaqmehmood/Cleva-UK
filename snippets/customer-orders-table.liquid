<table role="table">
  <caption class="sr-only">
    {{ 'customer.account.orders_title' | t }}
  </caption>

  <thead role="rowgroup">
    <tr role="row">
      <th id="ColumnOrder" scope="col" role="columnheader">
        {{ 'customer.account.order_number' | t }}
      </th>

      <th id="ColumnDate" scope="col" role="columnheader">
        {{ 'customer.account.date' | t }}
      </th>

      <th id="ColumnPayment" scope="col" role="columnheader">
        {{ 'customer.account.payment_status' | t }}
      </th>

      <th id="ColumnFulfillment" scope="col" role="columnheader">
        {{ 'customer.account.fulfillment_status' | t }}
      </th>

      <th id="ColumnTotal" scope="col" role="columnheader">
        {{ 'customer.account.total' | t }}
      </th>
    </tr>
  </thead>

  <tbody role="rowgroup">
    {% for order in customer.orders %}
      <tr role="row">
        <td
          id="RowOrder"
          role="cell"
          headers="ColumnOrder"
          data-label="{{ 'customer.account.order_number' | t }}"
        >
          <a
            href="{{ order.customer_url }}"
            aria-label="{{ 'customer.account.order_number_link' | t: number: order.name }}"
          >
            {{ order.name }}
          </a>
        </td>

        <td headers="RowOrder ColumnDate" role="cell" data-label="{{ 'customer.account.date' | t }}">
          {{ order.created_at | time_tag: format: 'date' }}
        </td>

        <td
          headers="RowOrder ColumnPayment"
          role="cell"
          data-label="{{ 'customer.account.payment_status' | t }}"
        >
          {{ order.financial_status_label }}
        </td>
        
        <td
          headers="RowOrder ColumnFulfillment"
          role="cell"
          data-label="{{ 'customer.account.fulfillment_status' | t }}"
        >
          {{ order.fulfillment_status_label }}
        </td>

        <td headers="RowOrder ColumnTotal" role="cell" data-label="{{ 'customer.account.total' | t }}">
          {{ order.total_net_amount | money_with_currency }}
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>
