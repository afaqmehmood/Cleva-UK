{% liquid
  assign class = class | append: ' w-full object-cover aspect-[1.55] md:aspect-[3.6]'

  assign width = 2000

  assign widths = '360, 720, 1080, 1500, 2000'
%}

{% capture sizes %}
  100vw
{% endcapture %}

{% assign sizes = sizes | strip_newlines | strip %}

<picture class="md:hidden">
  <source
    srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEAAAAALAAAAAABAAEAAAIBAAA="
    media="(min-width: 768px)"
  >

  {{
    image_mobile
    | image_url: width: width
    | image_tag: class: class, loading: loading, widths: widths, sizes: sizes
  }}
</picture>

<picture class="max-md:hidden">
  <source
    srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEAAAAALAAAAAABAAEAAAIBAAA="
    media="(max-width: 767px)"
  >

  {{ image | image_url: width: width | image_tag: class: class, loading: loading, widths: widths, sizes: sizes }}
</picture>
