<details class="h-full relative" x-data="video">
  <summary
    class="h-full group relative flex flex-col justify-center"
    role="button"
    aria-controls="product-video-{{ video.id }}"
    :aria-expanded="isOpen"
    @click.prevent="toggle()"
    x-bind="bindSlideFocusable"
  >
    {% render 'product-image', image: video.preview_image, loading: loading %}

    <div
      class="
        absolute top-1/2 left-1/2 -translate-y-1/2 -translate-x-1/2 max-md:scale-50
        p-6 bg-black group-hover:bg-gold-50 rounded-full
      "
    >
      {% render 'svg', name: 'play', class: 'text-[20px] text-white' %}
    </div>
  </summary>

  <div
    class="absolute inset-0 z-10 bg-black transition-opacity"
    id="product-video-{{ block.id }}"
    x-show="isOpen"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave-end="opacity-0"
  >
    {{ video
      | video_tag:
        class: 'w-full h-full object-cover',
        image_size: '1x',
        controls: true,
        preload: 'none'
      | replace: '<video', '<video x-ref="video"'
    }}
  </div>
</details>
