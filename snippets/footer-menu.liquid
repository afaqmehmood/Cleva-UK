{% capture list_html %}
  <ul class="max-lg:pb-6">
    {% for link in link.links %}
      <li class="mb-0.5 last:mb-0">
        <a class="text-white/60 hover:underline" href="{{ link.url }}">
          {{ link.title }}
        </a>
      </li>
    {% endfor %}
  </ul>
{% endcapture %}

{% if is_mobile %}
  <details
    class="group lg:hidden border-b border-grey-200"
    x-data="accordion"
    @keyup.escape.window="isOpen && toggle()"
    @click.outside="isOpen && toggle()"
  >
    <summary
      class="flex items-center justify-between gap-x-6 py-6 font-bold"
      role="button"
      aria-controls="footer-menu-{{ forloop.index }}"
      :aria-expanded="isOpen"
      @click.prevent="toggle()"
    >
      {{ link.title }}
      
      <span class="group-open:hidden p-1.5 border-2 rounded-full">
        {% render 'svg', name: 'plus', class: 'text-[14px]' %}
      </span>
      
      <span class="hidden group-open:block p-1.5 border-2 rounded-full">
        {% render 'svg', name: 'minus', class: 'text-[14px]' %}
      </span>
    </summary>

    {% if link.links %}
      <div
        class="!transition-[opacity,height] opacity-0 group-open:!opacity-100"
        :class="{
          'group-open:!opacity-100': false,
          '!opacity-100': isOpen
        }"
        id="footer-menu-{{ forloop.index }}"
        x-show="isOpen"
        x-collapse.duration.150ms
      >
        {{ list_html }}
      </div>
    {% endif %}
  </details>
{% else %}
  <div class="max-lg:hidden">
    <div class="font-bold mb-4">
      {{ link.title }}
    </div>

    {% if link.links %}
      {{ list_html }}
    {% endif %}
  </div>
{% endif %}
