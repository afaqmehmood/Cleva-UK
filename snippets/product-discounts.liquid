{% liquid
  assign metaobjects = shop.metaobjects.product_discount.values | where: 'global', true

  for metaobject in product.metafields.custom.discounts.value
    unless metaobject.global
      assign metaobject_as_array = metaobject | sort

      assign metaobjects = metaobjects | concat: metaobject_as_array
    endunless
  endfor
%}

{% if metaobjects != empty %}
  <ul class="-mt-[20px]">
    {% for metaobject in metaobjects %}
      <li class="border-b border-grey-50">
        <details
          class="group"
          x-data="accordion"
          @keyup.escape.window="isOpen && toggle()"
          @click.outside="isOpen && toggle()"
        >
          {% if metaobject.pretitle or metaobject.title %}
            <summary
              class="flex items-center justify-between gap-x-6 py-3"
              role="button"
              aria-controls="product-discounts-{{ section.id }}-{{ forloop.index }}"
              :aria-expanded="isOpen"
              @click.prevent="toggle()"
            >
              <span class="flex items-center gap-x-6">
                <span class="flex items-center gap-x-1.5">
                  {{ metaobject.pretitle }}

                  <span class="p-0.5 border rounded-full text-[10px]">
                    {% render 'svg', name: 'info' %}
                  </span>
                </span>

                <span class="text-grey-100">
                  {{ metaobject.title }}
                </span>
              </span>

              <span class="text-[12px] text-grey-100">
                <span class="group-open:hidden">
                  {% render 'svg', name: 'arrow', class: 'rotate-90' %}
                </span>
                
                <span class="hidden group-open:block">
                  {% render 'svg', name: 'arrow', class: '-rotate-90' %}
                </span>
              </span>
            </summary>
          {% endif %}

          {% if metaobject.text %}
            <div
              class="!transition-[opacity,height] opacity-0 group-open:!opacity-100"
              :class="{
                'group-open:!opacity-100': false,
                '!opacity-100': isOpen
              }"
              id="product-discounts-{{ section.id }}-{{ forloop.index }}"
              x-show="isOpen"
              x-collapse.duration.150ms
            >
              <div class="pt-1 pb-5 px-1 text-grey-100">
                {{ metaobject.text | metafield_tag }}
              </div>
            </div>
          {% endif %}
        </details>
      </li>
    {% endfor %}
  </ul>
{% endif %}
