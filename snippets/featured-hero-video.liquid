{% liquid
   unless class contains 'is-featured-text-video'
    assign class = class | append: 'w-full h-full object-cover'
   else 
    assign class = class | append: 'w-full h-full object-contain'
   endunless
  assign preload = null

  unless autoplay
    assign preload = 'none'
  endunless
%}

{{
  video
  | video_tag:
    class: class,
    image_size: '2000x',
    autoplay: autoplay,
    loop: autoplay,
    controls: controls,
    muted: autoplay,
    preload: preload,
    image_size: '1x'
  | replace: '<video', '<video x-ref="video"'
}}
