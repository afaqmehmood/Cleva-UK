{% liquid
  assign class = class | append: ' w-full object-cover transition-transform group-hover:scale-110 group-focus-within:scale-110'

  assign width = 2000

  assign widths = '280, 412, 560, 840'

  if aspect_ratio == 'square'
    assign class = class | append: ' aspect-square'
  endif
%}

{% capture sizes %}
  (min-width: 768px) calc(33vw - 62px),
  calc(87vw - 32px)
{% endcapture %}

{% assign sizes = sizes | strip_newlines | strip %}

{{ image | image_url: width: width | image_tag: class: class, loading: loading, widths: widths, sizes: sizes }}

