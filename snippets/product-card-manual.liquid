{% liquid
  if is_border == false
    assign is_border = false
  else
    assign is_border = true
  endif
%}

{% capture newline %}
{% endcapture %}

{% liquid
  assign newline_double = newline | append: newline

  assign badge_tags = settings.product_badge_tags | replace: newline_double, newline | split: newline
%}

<article
  class="
    group overflow-hidden relative h-full flex flex-col text-black

    {% if is_border %}
      p-4 bg-white border border-grey-100 rounded-2xl
    {% endif %}
  "
>
  {% if image %}
    <div class="overflow-hidden relative rounded-2xl mb-2.5">
      {% render 'product-card-image',
        image: image,
        loading: image_loading
      %}

      {% liquid
          if tags.size > 0
            render 'tags', tags: tags, whitelist_tags: badge_tags, class: 'absolute top-2 right-2 justify-end'
          endif
      %}
    </div>
  {% endif %}

  <div class="mb-4 last:mb-0">
    <h3>
      <a
        class="live-full-focus-ring"
        href="{{ url }}"
      >
        {% liquid
          assign title_class = 'block mb-1 last:mb-0 group-hover:underline'

          unless is_small_title
            assign title_class = title_class | append: ' font-bold text-[20px]/[25px]'
          endunless
        %}

        {% if pretitle %}
          <span class="block text-grey-200 mb-2.5" data-pretitle>
            {{ pretitle }}
          </span>
        {% endif %}

        <span class="{{ title_class }}" data-title>
          {{ title }}
        </span>

        {% if subtitle %}
          <span class="block text-grey-200 group-hover:underline" data-subtitle>
            {{ subtitle }}
          </span>
        {% endif %}
      </a>
    </h3>
  </div>

  {% if features.size > 0 %}
    <div class="mt-auto">
      <ul class="flex flex-col gap-y-1.5 text-[13px] text-grey-200 mb-4">
        {% for feature in features limit: 2 %}
          <li class="self-start flex items-center">
            <div class="mr-1.5 p-[3px] bg-black rounded-full text-[8px] text-white">
              {% render 'svg', name: 'tick' %}
            </div>

            <p>
              {{ feature }}
            </p>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
</article>
