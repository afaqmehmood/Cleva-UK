{% form 'customer_address', address, class: 'text-left' %}
  <h2 class="font-bold text-[20px]/[25px] text-center mb-6">
    {{ 'customer.addresses.edit_address' | t }}
  </h2>

  <label class="sr-only" for="AddressFirstName_{{ form.id }}">
    {{ 'customer.addresses.first_name' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="text"
    id="AddressFirstName_{{ form.id }}"
    name="address[first_name]"
    value="{{ form.first_name }}"
    autocomplete="given-name"
    placeholder="{{ 'customer.addresses.first_name' | t }}"
  >

  <label class="sr-only" for="AddressLastName_{{ form.id }}">
    {{ 'customer.addresses.last_name' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="text"
    id="AddressLastName_{{ form.id }}"
    name="address[last_name]"
    value="{{ form.last_name }}"
    autocomplete="family-name"
    placeholder="{{ 'customer.addresses.last_name' | t }}"
  >

  <label class="sr-only" for="AddressCompany_{{ form.id }}">
    {{ 'customer.addresses.company' | t }}
    </label>

  <input
    class="form-input mb-6"
    type="text"
    id="AddressCompany_{{ form.id }}"
    name="address[company]"
    value="{{ form.company }}"
    autocomplete="organization"
    placeholder="{{ 'customer.addresses.company' | t }}"
  >

  <label class="sr-only" for="AddressAddress1_{{ form.id }}">
    {{ 'customer.addresses.address1' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="text"
    id="AddressAddress1_{{ form.id }}"
    name="address[address1]"
    value="{{ form.address1 }}"
    autocomplete="address-line1"
    placeholder="{{ 'customer.addresses.address1' | t }}"
  >

  <label class="sr-only" for="AddressAddress2_{{ form.id }}">
    {{ 'customer.addresses.address2' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="text"
    id="AddressAddress2_{{ form.id }}"
    name="address[address2]"
    value="{{ form.address2 }}"
    autocomplete="address-line2"
    placeholder="{{ 'customer.addresses.address2' | t }}"
  >

  <label class="sr-only" for="AddressCity_{{ form.id }}">
    {{ 'customer.addresses.city' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="text"
    id="AddressCity_{{ form.id }}"
    name="address[city]"
    value="{{ form.city }}"
    autocomplete="address-level2"
    placeholder="{{ 'customer.addresses.city' | t }}"
  >

  <div class="mb-6">
    <label class="sr-only" for="AddressCountry_{{ form.id }}">
      {{ 'customer.addresses.country' | t }}
    </label>

    <select
      class="form-select"
      id="AddressCountry_{{ form.id }}"
      name="address[country]"
      data-address-country-select
      data-default="{{ form.country }}"
      data-form-id="{{ form.id }}"
      autocomplete="country"
    >
      {{ all_country_option_tags }}
    </select>
  </div>

  <div class="mb-6" id="AddressProvinceContainer_{{ form.id }}" style="display:none;">
    <label class="sr-only" for="AddressProvince_{{ form.id }}">
      {{ 'customer.addresses.province' | t }}
    </label>

    <select
      class="form-select"
      id="AddressProvince_{{ form.id }}"
      name="address[province]"
      data-default="{{ form.province }}"
      autocomplete="address-level1"
    ></select>
  </div>

  <label class="sr-only" for="AddressZip_{{ form.id }}">
    {{ 'customer.addresses.zip' | t }}
  </label>

  <input
    class="form-input mb-6"
    type="text"
    id="AddressZip_{{ form.id }}"
    name="address[zip]"
    value="{{ form.zip }}"
    autocapitalize="characters"
    autocomplete="postal-code"
    placeholder="{{ 'customer.addresses.zip' | t }}"
  >

  <label class="sr-only" for="AddressPhone_{{ form.id }}">
    {{ 'customer.addresses.phone' | t }}
  </label>
  
  <input
    class="form-input mb-6"
    type="tel"
    id="AddressPhone_{{ form.id }}"
    name="address[phone]"
    value="{{ form.phone }}"
    autocomplete="tel"
    placeholder="{{ 'customer.addresses.phone' | t }}"
  >

  <div class="flex gap-x-3 mb-6">
    {{ form.set_as_default_checkbox | replace: '<input', '<input class="form-checkbox"' }}

    <label class="font-bold text-[13px]/none text-grey-100" for="address_default_address_{{ form.id }}">
      {{ 'customer.addresses.set_default' | t }}
    </label>
  </div>

  <button class="form-button form-button--black w-full mb-6" type="submit">
    {{ 'customer.addresses.update' | t }}
  </button>

  <div class="text-center">
    <button class="group/button inline-flex items-center gap-x-4" type="reset">
      {{ 'customer.addresses.cancel' | t }}

      {% render 'svg', name: 'arrow', class: 'group-hover/button:translate-x-1 transition text-[14px]' %}
    </button>
  </div>
{% endform %}
