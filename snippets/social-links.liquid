{% assign social_handles = 'facebook, twitter, pinterest, instagram, tiktok, youtube, linkedin' | split: ', ' %}

<ul class="flex flex-wrap items-center gap-5">
  {% for social_handle in social_handles %}
    {% liquid
      assign social_setting_handle = 'social_' | append: social_handle
      assign social_setting = settings[social_setting_handle] | default: null

      unless social_setting
        continue
      endunless
    %}

    <li>
      <a href="{{ social_setting }}" target="_blank">
        {% render 'svg' name: social_handle, class: 'w-[30px] h-[30px]' %}

        <span class="sr-only">
          {{ social_handle | capitalize }}
        </span>
      </a>
    </li>
  {% endfor %}
</ul>
