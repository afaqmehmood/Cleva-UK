<!doctype html>
<html
  class="antialiased [&:has([open]_>_#mobile-menu)]:overflow-hidden [&:has([open]_>_#mobile-facet)]:overflow-hidden"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- render 'gcm-integration-script' -%}

    {% liquid
      render 'layout-meta'
      render 'layout-links'
      render 'layout-css-variables'
      render 'layout-schema'
      render 'layout-scripts'
    %}

    {{ content_for_header }}
  </head>

  <body>
    {% if template.name == 'password' %}
      {{ content_for_layout }}
    {% else %}
      {% render 'skip-to-main' %}

      {% sections 'header-group' %}

      <main id="main">
        {% if request.page_type == 'policy' %}
          {% render 'template-policy' %}
        {% else %}
          {{ content_for_layout }}
        {% endif %}
      </main>

      {% sections 'footer-group' %}

      {% section 'modal' %}

      {% render 'layout-grid' %}
    {% endif %}

    {% section 'app-optimization' %}
  </body>
</html>
