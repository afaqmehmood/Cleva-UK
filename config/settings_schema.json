  },
  {
    "name": "Product",
    "settings": [
      {
        "type": "checkbox",
        "id": "product_image_background_enable",
        "label": "Image background enable?",
        "info": "This will enable the proper grey background color for product images."
      },
      {
        "type": "color",
        "id": "product_image_background_color",
        "label": "Image background color",
        "info": "Only applied if 'Image background enable?' setting is checked."
      },
      {
        "type": "textarea",
        "id": "product_badge_tags",
        "label": "Badge tags",
        "info": "Tags defined here will display as badges if they exist. Separate each with a new line."
      }
    ]
  },
  {
    "name": "Product card",
    "settings": [
      {
        "type": "select",
