{% liquid
  assign search_terms = '“' | append: search.terms | append: '”'

  assign title_tag = section.settings.title_tag | default: null

  assign title = section.settings.title | default: null

  assign text = section.settings.text | replace: '[[ search_terms ]]', search_terms | default: null
%}

<section class="{% render 'section-class', section: section %} container main-grid">
  <div class="col-span-full md:col-start-3 md:col-span-8 lg:col-start-4 lg:col-span-6 text-center">
    {% if title %}
      <div class="font-display !font-bold text-[38px]/[48px] md:text-[44px]/[51px] mb-6 last:mb-0">
        {% render 'heading', tag: title_tag, text: title %}
      </div>
    {% endif %}

    {% if text %}
      <div class="font-bold text-[20px]/[25px] text-black/60">
        {{ text }}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
  {
    "name": "Simple Intro Block",
    "presets": [
      {
        "name": "Simple Intro Block"
      }
    ],
    "disabled_on": {
      "groups": ["*"]
    },
    "settings": [
      {
        "type": "select",
        "id": "padding_top",
        "label": "Padding top",
        "options": [
          { "value": "", "label": "None" },
          { "value": "2xs", "label": "2XS" },
          { "value": "xs", "label": "XS" },
          { "value": "sm", "label": "SM" },
          { "value": "md", "label": "MD" },
          { "value": "lg", "label": "LG" }
        ],
        "default": "md"
      },
      {
        "type": "select",
        "id": "padding_top_mobile",
        "label": "Padding top (mobile)",
        "options": [
          { "value": "", "label": "None" },
          { "value": "2xs", "label": "2XS" },
          { "value": "xs", "label": "XS" },
          { "value": "sm", "label": "SM" },
          { "value": "md", "label": "MD" },
          { "value": "lg", "label": "LG" }
        ],
        "default": "sm"
      },
      {
        "type": "select",
        "id": "padding_bottom",
        "label": "Padding bottom",
        "options": [
          { "value": "", "label": "None" },
          { "value": "2xs", "label": "2XS" },
          { "value": "xs", "label": "XS" },
          { "value": "sm", "label": "SM" },
          { "value": "md", "label": "MD" },
          { "value": "lg", "label": "LG" }
        ],
        "default": "md"
      },
      {
        "type": "select",
        "id": "padding_bottom_mobile",
        "label": "Padding bottom (mobile)",
        "options": [
          { "value": "", "label": "None" },
          { "value": "2xs", "label": "2XS" },
          { "value": "xs", "label": "XS" },
          { "value": "sm", "label": "SM" },
          { "value": "md", "label": "MD" },
          { "value": "lg", "label": "LG" }
        ],
        "default": "sm"
      },
      {
        "type": "select",
        "id": "title_tag",
        "label": "Title tag",
        "options": [
          { "value": "h1", "label": "H1" },
          { "value": "h2", "label": "H2" },
          { "value": "h3", "label": "H3" }
        ]
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title"
      },
      {
        "type": "richtext",
        "id": "text",
        "label": "Text"
      }
    ]
  }
{% endschema %}
