{% assign blocks = section.blocks | default: null %}

<style>
  .featured-bar-pdp #hydroheat {
    transform: scale(1.5);
    height: 40px !important;
    margin-top: 0.5rem;
  }
  @media (max-width: 767px) {
    .featured-bar-pdp #hydroheat {
      height: 22px !important;
    }
  }
</style>

{% if blocks %}
  <section class="{% render 'section-class', section: section %} container">
    <div
      class="
        main-grid py-6 py-12 max-md:px-[--container-padding-x]
        border border-grey-300 rounded-lg md:rounded-2xl
      "
    >
      <div class="col-span-full md:col-start-2 md:col-span-10 flex flex-wrap gap-y-12 -ml-12">
        {% for block in blocks %}
          {% liquid
            assign block_icon = block.settings.icon | default: null

            assign block_title = block.settings.title | default: null

            assign block_text = block.settings.text | default: null
          %}

          <div class="shrink-0 w-full md:w-1/2 xl:w-1/3 pl-12 flex gap-x-6 featured-bar-pdp">
            {% liquid
              if block_icon
                render 'svg', name: block_icon, class: 'text-[28px] md:text-[40px] w-auto md:mt-1 '
              endif
            %}

            {% if block_title or block_text %}
              <div class="flex-1 flex flex-col">
                {% if block_title %}
                  <h3 class="font-bold text-[20px]/[25px] md:text-[33px]/[50px] mb-4 last:mb-0">
                    {{ block_title }}
                  </h3>
                {% endif %}

                {% if block_text %}
                  {%
                    render 'text-truncate',
                    text: block_text,
                    truncate_enable: true,
                    class: 'mt-auto text-[20px]/[25px] text-grey-300'
                  %}
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

