{% liquid 
  assign vendor = collection.metafields.custom.vendor.value

  assign vendor_handle = vendor | handle

  assign products_per_page = settings.collection_products_per_page | default: 12

  assign facets_enable = collection.metafields.custom.filters_enable.value | default: true, allow_false: true

  if collection.filters == empty
    assign facets_enable = false
  endif

  case vendor_handle
    when 'vacmaster', 'lawnmaster', 'mx24v'
      assign logo = vendor_handle
  endcase
%}

<section
  class="{% render 'section-class', section: section %} md:overflow-hidden transition-opacity"
  id="collection-main"
  x-data="collectionMain({ sectionId: {{ section.id | json | escape }} })"
>
  {% paginate collection.products by products_per_page %}
    {% if logo %}
      <div class="relative z-10 pb-12 bg-white">
        <div class="container">
          {% render 'svg', name: logo, class: 'w-[164px] md:w-[200px] h-auto' %}
        </div>
      </div>
    {% endif %}

    {% if facets_enable %}
      <div data-ref="facets">
        {% liquid
          render 'mobile-facets', object: collection
          render 'facets', object: collection
        %}
      </div>
    {% endif %}

    <div class="container" :class="{ 'opacity-50': isLoading }" data-ref="productGridContainer">
      {% render 'pagination', part: paginate.previous, part_handle: 'previous', url_suffix: '#collection-main' %}

      <ul class="main-grid gap-y-6 min-h-[200px]" data-ref="productGrid">
        {% for product in collection.products %}
          {% liquid
            assign image_loading = null

            if forloop.index > 3
              assign image_loading = 'lazy'
            endif
          %}

          <li class="col-span-full md:col-span-4">
            {% render 'product-card', product: product, image_loading: image_loading, form_enable: true %}
          </li>
        {% endfor %}
      </ul>

      {% render 'pagination', part: paginate.next, part_handle: 'next', url_suffix: '#collection-main' %}
    </div>
  {% endpaginate %}
</section>

{% schema %}
  {
    "name": "Collection main",
    "presets": [
      {
        "name": "Collection main"
      }
    ],
    "enabled_on": {
      "templates": ["collection"]
    },
    "settings": [
      {
        "type": "select",
        "id": "padding_top",
        "label": "Padding top",
        "options": [
          { "value": "", "label": "None" },
          { "value": "2xs", "label": "2XS" },
          { "value": "xs", "label": "XS" },
          { "value": "sm", "label": "SM" },
          { "value": "md", "label": "MD" },
          { "value": "lg", "label": "LG" }
        ],
        "default": "md"
      },
      {
        "type": "select",
        "id": "padding_top_mobile",
        "label": "Padding top (mobile)",
        "options": [
          { "value": "", "label": "None" },
          { "value": "2xs", "label": "2XS" },
          { "value": "xs", "label": "XS" },
          { "value": "sm", "label": "SM" },
          { "value": "md", "label": "MD" },
          { "value": "lg", "label": "LG" }
        ],
        "default": "sm"
      },
      {
        "type": "select",
        "id": "padding_bottom",
        "label": "Padding bottom",
        "options": [
          { "value": "", "label": "None" },
          { "value": "2xs", "label": "2XS" },
          { "value": "xs", "label": "XS" },
          { "value": "sm", "label": "SM" },
          { "value": "md", "label": "MD" },
          { "value": "lg", "label": "LG" }
        ],
        "default": "md"
      },
      {
        "type": "select",
        "id": "padding_bottom_mobile",
        "label": "Padding bottom (mobile)",
        "options": [
          { "value": "", "label": "None" },
          { "value": "2xs", "label": "2XS" },
          { "value": "xs", "label": "XS" },
          { "value": "sm", "label": "SM" },
          { "value": "md", "label": "MD" },
          { "value": "lg", "label": "LG" }
        ],
        "default": "sm"
      }
    ]
  }
{% endschema %}
