{% liquid
  assign menu = section.settings.menu | default: null

  assign social_enable = section.settings.social_enable | default: null
%}

<footer class="overflow-hidden max-lg:relative pt-12 pb-20 bg-black text-white">
  <div class="container">
    <div class="lg:relative">
      {%
        render 'svg',
        name: 'watermark',
        class: 'absolute max-lg:bottom-4 max-lg:-right-36 lg:top-0 lg:bottom-0 lg:right-10 my-auto w-[426px] h-auto opacity-[.12]'
      %}

      <div class="relative">
        <a id="footer-logo" class="block w-fit lg:mb-12" href="{{ routes.root_url }}">
          {% render 'svg', name: 'logo', class: 'w-[96px] lg:w-[102px] h-auto' %}
        
          <span class="sr-only">
            {{ 'footer.logo' | t }}
          </span>
          <span class="block mt-3 text-white/60 text-[12px]">&copy; {{ 'now' | date: "%Y" }} {{ 'CLEVA EUROPE' }}</span>
        </a>
        
        {% if menu %}
          <div class="lg:flex lg:gap-x-12">
            {% for link in menu.links %}
              <div class="lg:flex-1">
                {% liquid
                  render 'footer-menu', forloop: forloop, link: link, is_mobile: true
                  render 'footer-menu', link: link
                %}
              </div>
            {% endfor %}

            {% if social_enable %}
              <div class="max-lg:py-6 max-lg:border-b max-lg:border-grey-200 lg:flex-1">
                <h2 class="font-bold mb-4">
                  {{ 'footer.socials' | t }}
                </h2>
            
                {% render 'social-links' %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
  {
    "name": "Footer",
    "presets": [
      {
        "name": "Footer"
      }
    ],
    "limit": 1,
    "enabled_on": {
      "groups": ["footer"]
    },
    "settings": [
      {
        "type": "header",
        "content": "Menu"
      },
      {
        "type": "link_list",
        "id": "menu",
        "label": "Menu"
      },
      {
        "type": "header",
        "content": "Social"
      },
      {
        "type": "checkbox",
        "id": "social_enable",
        "label": "Social enable?"
      }
    ]
  }
{% endschema %}
