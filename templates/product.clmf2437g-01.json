    "featured_cards_LbU947": {
      "type": "featured-cards",
      "blocks": {
        "card_XzYgYx": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/LawnMaster_37cm_Mower_Cutting.webp",
            "image_loading": "lazy",
            "title": "Complete Cordless Freedom",
            "text": "<p>Mow the lawn without the hassle of cables. Supplied with two powerful MX 24V 4.0Ah batteries and a 1 hour fast charger. One battery can be charged while the other is being used for almost continuous run time.</p>",
            "url": ""
          }
        },
        "card_Cmwr7p": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/LawnMaster_MX_24v_37cm_Mower_Battery.webp",
            "image_loading": "",
            "title": "iPower Intelligent Battery Management System",
            "text": "<p>Power delivery is automatically adjusted according to the grass conditions. Delivering extra power in tougher conditions and reserving battery life during lighter cutting. See the battery charge level at the touch of a button and manually increase the power if and when needed.</p>",
            "url": ""
          }
        },
        "card_p3THhR": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/LawnMaster_MX_24v_37cm_Mulching.webp",
            "image_loading": "",
            "title": "Mulching Function",
            "text": "<p>Choose from two ways to dispose of grass clippings. Collect in the 40L collapsible Redi-bag™ for green waste disposal, or use the supplied mulch plug to finely cut the clippings and return to the lawn as a nutrient.</p>",
            "url": ""
          }
        }
      },
      "block_order": [
        "card_XzYgYx",
