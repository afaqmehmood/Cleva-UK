        "entry_pWUUWG": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Why are cordless chainsaws useful for hedge care?",
            "text": "<p>Cordless <a href=\"/collections/chainsaws\" title=\"Chainsaws\">chainsaws</a> are used for pruning or felling small trees and large shrubs, and preparing logs for firewood. They can help you to cut through thicker growth on established hedges, like beech and conifer, that's too dense for a hedge trimmer.</p>",
            "button_1_style": "white",
            "button_1_text": "",
