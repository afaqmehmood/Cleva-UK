        "57014fb3-aa53-4b87-900b-e121ba207b93": {
          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "Can the mower be used at night?",
            "text": "<p>No. As the VBRM16 OcuMow™ requires good light in order for the camera to function, this mower can only be used in the daytime. The robot will not operate outside daylight hours.</p>",
            "button_1_style": "white",
