<div class="py-12 bg-grey-50">
  <div class="container space-y-12">
    <input class="form-input" type="text" value="Text">

    <select class="form-select">
      <option>Select</option>
    </select>

    <button class="form-button form-button--black" type="button">
      Button (black)
    </button>

    <button class="form-button form-button--white" type="button">
      Button (white)
    </button>

    <button class="form-button form-button--transparent-black" type="button">
      Button (transparent black)
    </button>

    <button class="form-button form-button--transparent-white" type="button">
      Button (transparent white)
    </button>

    <div class="flex gap-x-3">
      <input class="form-checkbox" type="checkbox" id="checkbox">

      <label class="font-bold text-[13px]/none text-grey-100" for="checkbox">
        Checkbox
      </label>
    </div>

    <div class="flex gap-x-3">
      <input class="form-radio" type="radio" id="radio">

      <label class="font-bold text-[13px]/none text-grey-100" for="radio">
        Radio
      </label>
    </div>
  </div>
</div>
