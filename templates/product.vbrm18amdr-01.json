            "image": "shopify://shop_images/OcuMow_18_VBRM18AMDR_Robot_Mower_Advanced_Technology_Alt2.webp",
            "image_loading": "lazy",
            "logo": "",
            "pretitle": "",
            "title_tag": "h3",
            "title": "Advanced Technology, Simplified.",
            "subtitle_tag": "h2",
            "subtitle": "",
            "text": "<p>Fusing high-definition camera and sensor technology, with our latest Optical Grass Recognition (OGR™) vision software, OcuMow® 18 accurately identifies grass, edges and objects to independently navigate around your lawn. Excels in small to large gardens up to 800m2 with mostly well-defined borders.<br/></p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": ""
          }
        }
      },
