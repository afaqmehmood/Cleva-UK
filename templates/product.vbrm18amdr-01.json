        "ab84675c-966a-4d70-969a-f700e3cbd841": {
          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "Is the installation tricky?",
            "text": "<p>Our OcuMow® 18 requires minimal installation. Find a suitable area for the charging station which should be within 10m of an outdoor power socket. Plug it in, put the mower on the charging station, set the schedule and the mower is ready to go. For advice on finding the best location for the charging station, please refer to the instruction manual the support section of our website.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
            "product_specifications": "",
