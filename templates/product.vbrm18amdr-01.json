    "featured_text_with_image_teMgqP": {
      "type": "featured-text-with-image",
      "blocks": {
        "text_with_image_3gyq7a": {
          "type": "text-with-image",
          "settings": {
            "align_content": "",
            "image": "shopify://shop_images/OcuMow_18_Robot_Mower_VBRM18AMDR_Plug_and_Play_Charging.webp",
            "image_loading": "lazy",
            "logo": "",
            "pretitle": "",
            "title_tag": "h3",
            "title": "Plug & Play Charging Station",
            "subtitle_tag": "h1",
            "subtitle": "",
            "text": "<p>Minimal install, plug-and-play charging station. Simply plug the charger into an outdoor power socket, set the schedule and OcuMow® 18 will do the rest. No guide wires to lay or boundaries to map. With the LawnMaster plug-and-play charging station you get the ultimate low-effort set up and operation.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": ""
          }
        }
