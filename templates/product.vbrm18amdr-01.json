        "b31ee862-e04c-41c1-b6df-1b81387257b3": {
          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "Can it cross driveways, paths and stepping stones?",
            "text": "<p>Driveways, paths and stepping stones are all detected by the mower as borders it cannot cross. The Drop and Mow setting means the mower can be used on unconnected lawns (for example, front lawns or lawns at other properties). The mower will work until the battery needs recharging and wait on the lawn to be picked up and returned to the base station. </p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
            "product_specifications": "",
            "html": "",
            "collection": "",
