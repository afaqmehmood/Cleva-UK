        "57014fb3-aa53-4b87-900b-e121ba207b93": {
          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "Will it cut up to edges?",
            "text": "<p>For safety, the mower stops approximately 10 - 20cm away from the edge of the lawn, meaning some grass will remain uncut. This can easily be taken care of with a grass trimmer such as our battery compatible LawnMaster MX 24V Grass Trimmer. Lawn edges should be kept neatly trimmed so that the OcuMow® 18 can easily see the edge of the lawn.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
