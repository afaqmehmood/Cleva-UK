        "1aa89dbd-9c7d-4a57-8d9f-4ea2cd5d1309": {
          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "Can the mower travel onto other lawns?",
            "text": "<p>The mower can independently navigate to lawns connected with a grass corridor at least 1.2m wide. If the grass corridor is more narrow than 1.2m or the lawn is completely separated by a wall, gravel, pathway or asphalt, the mower must be picked up and moved to the other lawn. The mower will need to be operated in Drop and Mow mode on this separate lawn.<br/></p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
