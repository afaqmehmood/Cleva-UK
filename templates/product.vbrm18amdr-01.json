        "entry_bDfmMy": {
          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "Is it safe to use around pets and children?",
            "text": "",
            "button_1_style": "white",
            "button_1_text": "The OcuMow® has an optional PIN feature which can be set to prevent children starting the mower unsupervised. Safety sensors stop the blades if the mower is lifted or flips over. The mower is also equipped with ultrasonic sensors which will avoid obstacles higher than 6cm. We recommend that children and pets are not left unsupervised with the mower while it is operating.",
            "button_1_url": "",
            "button_2_style": "white",
