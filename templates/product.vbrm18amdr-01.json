        "ff46babd-ca75-4940-b272-b5729c3d93d8": {
          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "I have a very small lawn, is OcuMow® 18 right for me?",
            "text": "<p>Because OcuMow® 18 can be scheduled to work for as little as one hour, once a week, it can be used even on very small lawns. As there is no guide wire necessary to help the mower find the base station, there is very little chance of worn patches developing in high traffic areas.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
            "product_specifications": "",
