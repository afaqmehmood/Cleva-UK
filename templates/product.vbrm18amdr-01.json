        },
        "c0197e1c-14fd-4d4c-9b30-09cb28171157": {
          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "Can the mower be used at night?",
            "text": "<p>As OcuMow® 18 requires good light in order for the camera to function, this mower can only be used in the daytime. The robot will not operate outside daylight hours. </p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
