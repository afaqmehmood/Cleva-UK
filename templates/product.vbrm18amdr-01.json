        },
        "9dfe8da6-23bb-4e63-a961-3a0b283987d6": {
          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "How does it find the base station?",
            "text": "<p>The mower has an on-board GPS sensor which the mower uses to get close to the base station. Once the mower is close to the station, it uses the camera to navigate back on to the dock. </p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
