          "type": "card",
          "settings": {
            "image": "shopify://shop_images/LawnMaster_32cm_Cordless_RediBag.webp",
            "image_loading": "",
            "title": "Ready to Go",
            "text": "<p>Use with the 30L Redi-bag grass collector to collect the grass clippings for a neat finish. The Redi-bag requires minimal assembly out of the box, simply unfold it and clip in the handle. The indicator flap lets you know when the grass collector is full.</p>",
            "url": ""
          }
        }
