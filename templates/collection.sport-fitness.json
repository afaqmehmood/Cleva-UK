          }
        },
        "090a05a9-c530-405c-8480-12d5b201f814": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Which features are useful on an indoor fitness and cycling fan?",
            "text": "<p>As the primary goal of a fitness fan is to cool you down, look for fans with variable speed control, tilt options and a remote control. For some, low noise and energy efficiency are also important.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
