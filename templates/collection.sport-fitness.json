        "entry_9CidLh": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "What is the main benefit of an indoor training and cycling fan?",
            "text": "<p>A purposefully designed turbo fan provides a powerful, targeted airflow for rapidly cooling you down during a tough workout session. A high output fan can keep your body temperature at its optimum level so that you can keep going for longer and build endurance.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
