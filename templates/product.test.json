            "image_loading": "",
            "logo": "",
            "pretitle": "Features",
            "title_tag": "h1",
            "title": "Spot Cut Function",
            "subtitle_tag": "h1",
            "subtitle": "",
            "text": "<p>For a neat finish, use the additional spiral spot cut function on any patches of uncut grass.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": ""
