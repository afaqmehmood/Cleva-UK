        },
        "entry_dUXKiw": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "How do robot lawn mowers work?",
            "text": "<p>Requiring minimal human intervention, robot mowers cut the lawn in a sequential or random pattern and drop the clippings back onto the lawn's surface, acting as a natural fertiliser. </p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
