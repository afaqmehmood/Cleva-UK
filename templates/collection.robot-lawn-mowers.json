          }
        },
        "entry_UFpFKF": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Who would use a robot grass cutter?",
            "text": "<p>Robot grass cutters are ideal for busy households, or those looking to outsource heavy gardening work, as well as technology enthusiasts looking for the latest must-have gardening appliance. </p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
