            "video_1": "",
            "video_2": ""
          }
        },
        "entry_4BG9Uw": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Which classification of dust extractor do I need for a construction site?",
            "text": "<p>L Class extractors are suitable for exposure to lower toxicity dusts such as soft woods (cedar, pine, yew) greater than 1 milligram per cubic metre, while M Class extractors, being the next step up, are used for extracting dust from hard wood, brick and concrete greater than 0.1 milligram per cubic metre. H Class vacuum cleaners have the highest level of filtration and are used to extract extremely harmful materials such as asbestos, formaldehyde and even carcinogenic substances.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
