            "image_loading": "",
            "title": "Rear Roller",
            "text": "<p>The Lawnmower's integrated rear roller helps you achieve a precise, professional striped finish on your lawn.</p>",
            "url": ""
          }
        },
        "card_DcHDhV": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/LawnMaster_37cm_Combo_Freedom.webp",
            "image_loading": "",
            "title": "Continuous Cutting",
            "text": "<p>With a one hour fast charger and an included additional battery, one battery can be used while the other is charging for almost continuous mowing over larger cutting areas.</p>",
            "url": ""
          }
        },
        "card_DXAWKw": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/37cm_Combo_Grass_Box_Indicator.webp",
            "image_loading": "",
            "title": "Grass Box Full Indicator",
            "text": "<p>The Lawnmower's indicator flap closes when the grass box is full. Allows you to empty at the right time to maximise battery run time and minimise blockages.</p>",
            "url": ""
          }
        }
      },
