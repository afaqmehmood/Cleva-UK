    "featured_cards_LbU947": {
      "type": "featured-cards",
      "blocks": {
        "card_XzYgYx": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/Cardio54_AM1202R_Remote_Control.webp",
            "image_loading": "lazy",
            "title": "Remote Control",
            "text": "<p>Adjust the fan speed effortlessly with the included remote control, allowing you to select the speed setting without interrupting your workout. Choose the optimal speed to match your intensity level with 3 pre-selected controls. Remote and batteries included.</p>",
            "url": ""
          }
        },
        "card_Cmwr7p": {
          "type": "card",
          "settings": {
