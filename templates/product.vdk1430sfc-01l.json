            "image_loading": "lazy",
            "logo": "",
            "pretitle": "",
            "title_tag": "h2",
            "title": "Wet & Dry Extraction",
            "subtitle_tag": "h1",
            "subtitle": "",
            "text": "<p>Vacuum either wet or dry debris. Fit the HEPA cartridge filter and optional dust bag to capture dry debris. Switch to the foam filter to extract liquids.</p>",
            "button_1_style": "black",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
