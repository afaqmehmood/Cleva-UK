        "text_with_image_pRxFRp": {
          "type": "text-with-image",
          "settings": {
            "align_content": "",
            "image": "shopify://shop_images/Bagged_Upright_Vacuum_Captura2.webp",
            "image_loading": "lazy",
            "logo": "",
            "pretitle": "",
            "title_tag": "h2",
            "title": "AllergenPro™ Sealed Dust System",
            "subtitle_tag": "h1",
            "subtitle": "",
            "text": "<p>The AllergenPro™ Dust Management System channels the vacuum's airstream through three stages of filtration. Microscopic particles are first filtered through a 5 layer Ultra Filtration Dust Bag, before passing through a washable foam filter and then finally reaching a high-grade HEPA 13 exhaust filter. Capturing microscopic dust particles and sealing in 99.9% of dirt and allergens from the vacuum's airstream including pollen, mould, and bacteria.* Helping to keep them out of the air you breathe. *According to EN 60312-1 at 0.3 to 10 microns.</p>",
            "button_1_style": "black",
            "button_1_text": "Learn more",
            "button_1_url": "",
            "button_2_style": "transparent-black",
            "button_2_text": "",
            "button_2_url": ""
          }
        }
      },
      "block_order": [
        "text_with_image_pRxFRp"
      ],
      "settings": {
        "padding_top": "xs",
        "padding_top_mobile": "2xs",
        "padding_bottom": "sm",
        "padding_bottom_mobile": "sm"
      }
