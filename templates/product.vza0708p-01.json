          "type": "text-with-image",
          "settings": {
            "align_content": "",
            "image": "shopify://shop_images/Long_Cable_Vacmaster_D8_Vacuum_Cleaner_VZA0708P.webp",
            "image_loading": "",
            "logo": "",
            "pretitle": "",
            "title_tag": "h2",
            "title": "26m Working Range",
            "subtitle_tag": "h1",
            "subtitle": "",
            "text": "<p>An extra long 10m cable provides ultimate flexibility. With an overall working reach of 26 metres, a huge 8 litre dust capacity and onboard tool for every job, down-time is kept to a minimum.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
