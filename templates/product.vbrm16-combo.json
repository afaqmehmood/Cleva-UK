          "type": "text-with-image",
          "settings": {
            "align_content": "",
            "image": "shopify://shop_images/LawnMaster_VBRM16_robot_lawmowe_simple_operation_keypad.webp",
            "image_loading": "lazy",
            "logo": "",
            "pretitle": "",
            "title_tag": "h2",
            "title": "Drop & Mow",
            "subtitle_tag": "h1",
            "subtitle": "",
            "text": "<p>No need for an outdoor power socket. Simply charge the detachable lithium-ion batteries in the 1 hour fast charger provided and put the mower on the lawn once or twice a week during the daytime in dry weather.</p>",
            "button_1_style": "black",
            "button_1_text": "",
            "button_1_url": "",
