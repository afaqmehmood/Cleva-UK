        "entry_AkxNVh": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Do I need a dust extractor in my workshop?",
            "text": "<p><a href=\"/collections/dust-extractors\" title=\"Dust Extractors\">Dust extractors</a>, like those in the Vacmaster L & M class range, have a professional specification for trade, workshop and construction use. In these environments, having a vacuum cleaner with a certified level of dust extraction is vital. It not only keeps you within the law, but also minimises your and your employee's exposure to potentially harmful dust particles.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
            "product_specifications": "",
            "html": "",
            "collection": "",
            "collection_products_per_page": 8,
            "products": [],
