        "entry_FpzLJa": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "What classification of dust extractor do I need for a workshop?",
            "text": "<p><a href=\"/collections/l-class-dust-extractors\" title=\"L-Class Dust Extractors\">L class dust extractors</a> are suitable for exposure to lower toxicity dusts such as soft woods (cedar, pine, yew) greater than 1 milligram per cubic metre, while M class extractors, being the next step up, are used for extracting dust from hard wood, brick and concrete greater than 0.1 milligram per cubic metre. H class vacuum cleaners have the highest level of filtration and are used to extract extremely harmful materials such as asbestos, formaldehyde and even carcinogenic substances.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
