            "video_1": "",
            "video_2": ""
          }
        },
        "entry_VdpEKP": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "How do I know the classification of a dust extractor?",
            "text": "<p>L-class and <a href=\"/collections/m-class-dust-extractors\" title=\"M-Class Dust Extractors\">M-class dust extractors</a> that have been certified as meeting HSE standards are easy to spot. The level of classification should be prominently displayed in the form of a sticker attached to the machine. If it doesn't have the sticker and you're in doubt as to whether it's classified or not, contact the the manufacturer.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
            "product_specifications": "",
            "html": "",
