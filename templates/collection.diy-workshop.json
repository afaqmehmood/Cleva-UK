      "blocks": {
        "entry_h3kLNN": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "What is the best garage vacuum cleaner?",
            "text": "<p><a href=\"/collections/wet-and-dry-vacuum-cleaners\" title=\"Wet & Dry Vacuum Cleaners\">Wet and dry vacuum cleaners </a>quickly and efficiently clean up both liquids and heavier duty dried dirt. This combination of power and versatility makes them ideal for use in workshops and garages.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
            "product_specifications": "",
            "html": "",
            "collection": "",
            "collection_products_per_page": 8,
            "products": [],
            "image_loading": "",
            "video_1": "",
            "video_2": ""
          }
        },
        "entry_nWP9k3": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Which features are useful on a vacuum cleaner for DIY use?",
            "text": "<p>Wet and dry vacuum cleaners provide the power and versatility needed for most DIY-related clean ups. Look for powerful suction, good filtration, long power cord, and a robust, well-balanced design. </p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
            "product_specifications": "",
