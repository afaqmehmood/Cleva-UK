        "entry_4jzjBX": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Which features are useful on a vacuum?",
            "text": "<p>Look for vacuum cleaners with powerful suction, HEPA filtration and that are light and easy to use. Reach and power source are important for larger spaces and those with stairs.</p>",
