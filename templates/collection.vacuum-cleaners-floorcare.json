          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Which is the best vacuum cleaner?",
            "text": "<p>When choosing the best vacuum cleaner for you, consider factors like floor size, surface types, number of stairs, availability of power sockets and the type of dirt being vacuumed.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
