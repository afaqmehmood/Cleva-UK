          }
        },
        "entry_Db6QGk": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "What types of vacuum cleaner are available?",
            "text": "<p>There are a wide range of vacuums available, including cordless, cylinder and<a href=\"/collections/upright-vacuum-cleaners\" title=\"Upright Vacuum Cleaners\"> upright vacuum cleaners</a>. Wet and dry vacuum cleaners are highly versatile, perfect for both indoor and outdoor use.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
