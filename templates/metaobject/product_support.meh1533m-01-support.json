        "entry_rmawJ9": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "The motor is labouring, why?",
            "text": "<p>This can be caused by a build up of grass clipping on the underside of the hover mover deck, causing it to clog.</p><p>Check underneath the mower<br/>and scrape off the dried mulch with the plastic scraper supplied with the mower.</p>",
