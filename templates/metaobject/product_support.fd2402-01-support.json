        "entry_rr7RDw": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Why won't my garden shredder start?",
            "text": "<p>1. The overload protection has tripped. Wait until the motor has cooled down. Press the reset button, and then restart the shredder.</p><p>2. The lid of shredder housing is not secured properly. Tighten the housing interlock to correctly secure the shredder housing.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
