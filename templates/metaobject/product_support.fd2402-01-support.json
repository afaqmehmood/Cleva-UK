        "entry_GRkFLD": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "The shredder has stopped drawing the twigs and branches in, why?",
            "text": "<p>1. Shredding material is too soft.<br/>Use the plunger or add dry twigs/<br/>branches.</p><p>2. Shredder is blocked. Refer to Clearing a Blockage section above.</p><p>3. Shredding material is in discharge duct. Remove shredding material from<br/>discharge duct.</p>",
            "button_1_style": "white",
            "button_1_text": "",
