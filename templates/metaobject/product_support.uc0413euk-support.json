    "df696699-42a8-4b2a-8976-674c3e309cd2": {
      "type": "featured-accordion",
      "blocks": {
        "d7624e53-96f3-43a2-a5b4-052847d8844f": {
          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "Setting Up",
            "text": "<p>1. Remove the pre-installed screw bolt with a screwdriver or a coin. Insert the handle assembly into the main body and secure with the screw bolt.<br/>2. Insert the larger end of the extension wand into the top of the connection hose through the bracket until the wand is fully seated on the post.<br/>3. Insert the end of the flexible hose into the main body by aligning the UNLOCKED marks. Rotate the hose until the marks align with the LOCKED symbol. Run the flexible hose over the lower hose storage and the upper hose storage. Insert the suction hose end onto the top of the extension wand.<br/>4. Insert the combination tool onto the accessory storage post located on the back of the main body.<br/>5. Wrap the power cord around the upper and lower cord hooks.</p>",
            "button_1_style": "black",
            "button_1_text": "",
            "button_1_url": "/",
            "button_2_style": "link",
            "button_2_text": "",
            "button_2_url": "/",
            "product_specifications": "",
            "html": "",
            "collection": "",
            "collection_products_per_page": 8,
            "products": [],
            "image_loading": "",
            "video_1": "",
            "video_2": ""
          }
        },
        "80d3ee7d-e860-4a9c-8b84-2c5508cdf136": {
          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "Maintenance",
            "text": "<p><strong>Cleaning the Pre-Filter</strong><br/><br/>1) Remove the dust bin.<br/>2) Press the dust bin lid release button.<br/>3) Grasp the pre-filter and rotate counterclockwise.<br/>4) Clean pre-filter by gently tapping. DO NOT use detergent or soap. Allow parts to dry 24 hours before putting back into vacuum cleaner. DO NOT wash in the dishwasher. DO NOT install damp.<br/>5) Place the pre-filter back into the dust bin and rotate clockwise to lock into place.<br/>6) Reinstall the dust bin into the main body.<br/><br/><strong>Cleaning the Pre-Motor Filters</strong><br/><br/>Rinse filters with cold water only. Allow all filters to air-dry for at least 24 hours before reinstalling them to prevent liquid from being drawn into electronic parts.<br/><br/>NOTE: When the cleaning of filters no longer restores vacuum cleaner suction to full power, or the filters are worn or broken, replace the filters. To purchase filters, contact the After Sales Helpline. It is recommended to clean the foam and felt filters with cold water every three months.<br/><br/><strong>Cleaning the HEPA Exhaust Filter</strong><br/><br/>1) Remove the exhaust filter cover by pressing the release tab at the bottom of the cover. Remove the HEPA exhaust filter together with the foam filter.<br/>2) Wash with cold water only. DO NOT use detergent or soap. Allow to air dry. Allow parts to air dry before putting back into vacuum cleaner. DO NOT operate without exhaust filter installed. DO NOT wash in the dishwasher. DO NOT install the filter if damp.<br/>3) Replace the foam filter to the HEPA exhaust filter first. Then replace the HEPA exhaust filter with foam filter into the vacuum cleaner.<br/>4) Insert the exhaust filter cover tabs into the upper slots and lock the filter cover into place by pressing the lower part of the cover until a click is heard.<br/><br/>NOTE: It is recommended to clean the HEPA exhaust filter with cold water every year.<br/><br/><strong>WrapFree Brushroll</strong><br/><br/>If you see any hair wrapped around the brushroll, continue cleaning, ensuring the On/Off switch is in 'II' position with the brushroll rotating on low pile carpets or tile floors. Hair will be removed from the WrapFree brushroll and be sucked into the dust bin.</p>",
            "button_1_style": "",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "",
            "button_2_text": "",
            "button_2_url": "",
