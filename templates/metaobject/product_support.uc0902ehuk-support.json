        "d7624e53-96f3-43a2-a5b4-052847d8844f": {
          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "Setting Up",
            "text": "<p>1. Insert the wand into the main body until you hear a ‘click’.<br/>2. Insert the handle into the wand until you hear a ‘click’.<br/>3. Insert one end of the flexible suction hose into the main body until you hear a ‘click’.<br/>4. Insert the other end of the hose into the handle until you hear a ‘click’.<br/>5. Insert the combination tool and the upholstery tool onto the accessory storage located on the back of the main body.<br/>6. Wrap the power cord around the upper and lower cord hooks.</p><p>NOTE: Make sure to wrap the power cord around the upper cord hook first, and then around the lower cord hook to avoid damaging the power cord.</p>",
            "button_1_style": "black",
            "button_1_text": "",
            "button_1_url": "/",
            "button_2_style": "link",
            "button_2_text": "",
            "button_2_url": "/",
            "product_specifications": "",
