          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "Setting Up",
            "text": "<p>1. Insert the handle into the wand and secure with the provided screw.<br/><br/>NOTE: Tighten the screw with a Phillips head screwdriver. Ensure that the screw is secured.<br/><br/>2. Insert the wand into the main body until you hear a ‘click’.<br/><br/>3. Wrap the power cord around the upper and lower cord hooks.<br/><br/>NOTE: Make sure to wrap the power cord around the upper cord hook first, and then around the lower cord hook to avoid damaging the power cord.</p>",
            "button_1_style": "black",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "link",
            "button_2_text": "",
            "button_2_url": "",
