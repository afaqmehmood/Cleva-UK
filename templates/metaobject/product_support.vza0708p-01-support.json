        "d7624e53-96f3-43a2-a5b4-052847d8844f": {
          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "Setting Up",
            "text": "<p>1. Remove the pre-installed pre-filter, and fully fit the dust bag flange onto the inlet stub. Place the pre-filter back into the container.<br/><br/>NOTE: Ensure the bag and filter are always fitted before use.<br/><br/>3. Fit the power head back onto the collection tank by securing the two latches. Ensure the power head sits properly on the collection tank and is correctly sealed.<br/>4. Attach the locking end of the hose into the suction port of the container and turn clockwise to tighten.<br/>5. Choose the desired accessories and/or extension wands and push and twist onto the hose nozzle. </p>",
            "button_1_style": "black",
            "button_1_text": "",
            "button_1_url": "/",
            "button_2_style": "link",
            "button_2_text": "",
            "button_2_url": "/",
            "product_specifications": "",
            "html": "",
            "collection": "",
            "collection_products_per_page": 8,
            "products": [],
            "image_loading": "",
