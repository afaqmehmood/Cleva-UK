        "entry_4zYDKH": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "My lawn has hard borders/raised edges but is bigger than 100m2, can I still use this mower?",
            "text": "<p>The VBRM16 OcuMow™ works with our MX 24V 4.0Ah battery. The mower will cover 100m2 on a single charge. Lawn coverage can be increased with the additional battery supplied with grass trimmer.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
