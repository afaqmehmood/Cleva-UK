          }
        },
        "f65aa26e-6f20-4e9c-a91b-0a269239be79": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Will it cut up to edges?",
            "text": "<p>The mower stops approximately 10 - 20cm away from the edge of the lawn, meaning some grass will remain uncut. This can easily be taken care of with the MX 24V 25cm included grass trimmer.  </p><p>Lawn edges should be kept neatly trimmed so that the VBRM16 OcuMow™ can easily see the edge of the lawn.</p>",
            "button_1_style": "",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "",
            "button_2_text": "",
            "button_2_url": "",
