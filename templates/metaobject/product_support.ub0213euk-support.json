    "df696699-42a8-4b2a-8976-674c3e309cd21": {
      "type": "featured-accordion",
      "blocks": {
        "d7624e53-96f3-43a2-a5b4-052847d8844f": {
          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "Why is the dirt pick-up/suction power under performing?",
            "text": "<p>This can be caused by:<br/><br/>1. The hose and attachments are not installed correctly. Check the hose and attachments for correct installation and ensure they are snapped firmly in place.<br/>2. Dust bag is not installed correctly. Check dust bag for correct installation and ensure it is snapped firmly in place.<br/>3. Full dust bag. Change the dust bag.<br/>3. There is a blockage in the air path. Check and remove all blockages.<br/>4. Suction control valve is in open position. Adjust the suction control to increase suction. <br/>5. The foam filter or HEPA exhaust filter needs to be cleaned or replaced. Clean or replace the foam filter or HEPA exhaust filter. <br/></p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "/",
            "button_2_style": "link",
            "button_2_text": "",
            "button_2_url": "/",
            "product_specifications": "",
