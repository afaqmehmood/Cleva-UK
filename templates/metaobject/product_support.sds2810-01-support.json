        "entry_zF4erB": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Setting Up",
            "text": "<p><strong>Attaching the Shredder Unit </strong></p><p>1. Place the shredder unit onto the chassis. Fix it from underneath with the four screws provided.</p><p><strong>Inserting the Collection Box </strong></p><p>NOTE: Before inserting the collection box, make sure the collection box safety switch is in the ‘UNLOCK’ position.</p><p>1. Insert the collection box into the chassis. The collection box can only be fitted in one direction.</p><p>2. Lock the the collection box by rotating the safety switch clockwise to the ‘LOCK’ position.</p><p>NOTE: The collection box must be locked firmly; otherwise the shredder cannot be switched on.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
            "product_specifications": "",
            "html": "",
