        "f65aa26e-6f20-4e9c-a91b-0a269239be79": {
          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "Why is the Motor making a high pitched noise?",
            "text": "<p>This can be caused by:<br/><br/>1. Dirty water tank is full. Empty the dirty water tank.<br/>2. The suction hose is clogged. Clean the hose.<br/>3. The float in the dirty water tank has been activated. Empty and clean the dirty water tank.</p>",
