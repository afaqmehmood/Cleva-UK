        "80d3ee7d-e860-4a9c-8b84-2c5508cdf136": {
          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "Maintenance",
            "text": "<p><strong>Cleaning Nozzle and Attachments</strong><br/><br/>It is recommended to clean attachments with water after each use.<br/>1) Press the tool release button to remove the attachment from the hose.<br/>2) Press the cover release button on the nozzle to remove the cover.<br/>3) Rinse thoroughly with clean water. Allow the parts to dry before reinstalling. DO NOT wash in the dishwasher. DO NOT install whist still damp.<br/>4) Reinstall the nozzle cover and the insert back into place until a click is heard.<br/><br/><strong>Cleaning the Filter Grill</strong><br/><br/>1) Remove the dirty water tank from the side of the unit.<br/>2) Remove any dirt and debris from the filter grill.</p>",
