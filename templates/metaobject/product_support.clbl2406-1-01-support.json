        "entry_Hkkm9X": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Setting Up",
            "text": "<p>1. Align the widest end of the blower tube with the front opening on the blower.</p><p>2. Slide the blower tube over the blower outlet opening until the latch snaps into place.</p><p>3. Fully charge the battery and insert. Slide the battery pack fully towards the handle until the latch locks into place.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
            "product_specifications": "",
            "html": "",
