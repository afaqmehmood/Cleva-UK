        "entry_HFcpeE": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Setting Up",
            "text": "<p>The LawnMaster 24V Hedge Trimmer is supplied fully assembled. </p><p>To operate all you need to do is fully charge and install the battery, and remove the protective sleeve from the blade.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
