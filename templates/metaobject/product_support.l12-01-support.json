          }
        },
        "entry_WtTNFK": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Is it noisy?",
            "text": "<p>The L12 is extremely quiet at only 62dB. Enjoy a snooze while the L12 takes care of the lawn!</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
