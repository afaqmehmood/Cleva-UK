        "entry_QBXwAX": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Can I leave it out all year round?",
            "text": "<p>It is recommended to bring the L12 indoors to a dry garage or shed when the main growing season is finished (usually around the end of October). </p><p>The product should be charged before storing to keep the battery in optimum condition.</p><p>It is also recommended to give the mower a thorough clean and take the opportunity to replace blades and check for software updates before the new season. The charging station can be left outside year round.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
