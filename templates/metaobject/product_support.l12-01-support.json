        "entry_8yTKhM": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "What security features does the mower have? Will it be stolen?",
            "text": "<p>The L12 requires PIN code entry after each time the stop button is pressed, or the machine is turned off and on again via the switch underneath the mower. This removes the possibility for children and unauthorised persons to operate the machine.</p>",
            "button_1_style": "white",
            "button_1_text": "",
