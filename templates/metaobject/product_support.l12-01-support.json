        "entry_gF8JXT": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "What is the warranty period?",
            "text": "<p>The L12 comes with a 2-year warranty against manufacturing defects. This does not cover wear and tear, consumables such as blades, accidental damage or use not in accordance with the recommendations. If you suspect your L12 has a defect, please contact us using the form below.</p>",
            "button_1_style": "white",
            "button_1_text": "",
