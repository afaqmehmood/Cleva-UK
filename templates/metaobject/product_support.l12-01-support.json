          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Setting Up",
            "text": "<p>Learn how to set up the  LawnMaster L12 Robot Mower with our quick start guide and video. Expect set up to take just over an hour and remember that you only have to do this once before you can sit back and watch it go!</p>",
            "button_1_style": "black",
            "button_1_text": "Download Quick Start Guide PDF",
            "button_1_url": "https://cdn.shopify.com/s/files/1/0050/9811/1010/files/Robotic_Mower_L_Series_Quick_Start_Installation_V1_2023-min.pdf?v=1679907255",
            "button_2_style": "link",
            "button_2_text": "",
            "button_2_url": "",
            "product_specifications": "",
            "html": "",
            "collection": "",
            "collection_products_per_page": 8,
