        "entry_BLQDi8": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "How do I adjust trimmer line manually?",
            "text": "<p>1. Switch off the trimmer and remove the battery.</p><p>2. Press the line release button (②), pull the end of the trimming line out and release line release button.</p><p>Avoid releasing a very long length of the trimming line.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
