        "entry_aLbBGM": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Why is my trimmer making a loud noise?",
            "text": "<p>This could be one of three reasons:</p><p>1. The line spool is dirty. Check and clean if it is.</p><p>2. The spool is defective. Replace the spool if it is defective. Watch the video in the maintenance section above to see how.</p><p>3. There is a problem with the motor. Please contact us.</p>",
            "button_1_style": "white",
            "button_1_text": "",
