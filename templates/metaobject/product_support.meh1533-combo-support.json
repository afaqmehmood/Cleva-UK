        "entry_pEApKY": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "My hover mower motor is labouring, why?",
            "text": "<p>This can be caused by a build up of grass clipping on the underside of the hover mover deck, causing it to clog.</p><p>Check underneath the mower and scrape off the dried mulch with the plastic scraper supplied with the mower.</p>",
