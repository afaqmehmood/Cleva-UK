        "entry_ixmQTt": {
          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "Why is the suction power underperforming?",
            "text": "<p>This can be caused by:<br/><br/>1) Dust bag is full. Replace the dust bag.<br/>2) Suction nozzle, hose, or tank inlet is blocked. Check the suction nozzle, hose, and tank inlet for obstructions.<br/>3) Cartridge filter is blocked. Remove the cartridge filter and clean.<br/>4) Float valve has closed. Empty the container of any liquid waste and ensure the float value located underneath the filter is able to move freely.</p>",
            "button_1_style": "white",
