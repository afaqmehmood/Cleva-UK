        "entry_6dj9zf": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "The mower is not collecting the grass clipping very well, why?",
            "text": "<p>This can be due the grass being too long. Cut long grass down in stages by gradually lowering the height of cut.</p><p>Or, the grass may be too wet. Wait for wet grass to dry.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
