            "logo": "",
            "pretitle": "",
            "title_tag": "h2",
            "title": "Anti Static Connection System",
            "subtitle_tag": "h1",
            "subtitle": "",
            "text": "<p>Full anti-static accessory and suction hose system. Prevents the build-up of static charge and blockages caused by ultra-fine grain particles building up in the hose, suction tubes and tools.</p>",
            "button_1_style": "black",
            "button_1_text": "",
            "button_1_url": "",
