          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "How often should I cut the grass?",
            "text": "<p>Advice for cultivating the best looking lawn is actually to cut twice a week, never removing more than a third of the grass length.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
