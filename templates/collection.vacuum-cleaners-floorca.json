        "dbf0b017-1cc9-4826-ba6d-3f6f82f3abc5": {
          "type": "entry",
          "settings": {
            "title": "My order hasn’t arrived",
            "text": "<p>If your delivery date has passed and you haven't received your order, log into the My Account section of our website, open your orders and click on the tracking link provided to trace where your parcel is up to with our courier partner. Please note that all of our Vacuum Cleaners, Air Movers, Fans and Lawnmaster products require a signature upon delivery. If this can’t be obtained by the courier then your order will be returned to the delivery depot, and you will need to contact them to arrange a collection or a new delivery.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
