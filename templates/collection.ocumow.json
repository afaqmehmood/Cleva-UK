        "entry_pbrUJM": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Can OcuMow® robot mowers be used at night?",
            "text": "<p>No. OcuMow® robot mowers require good light in order for the camera to function. The robot will not operate outside daylight hours. If this is a requirement, consider our LawnMaster L10 and L12 robot mowers. </p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
