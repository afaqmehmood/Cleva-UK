    "0aa96139-5b59-4ced-a8c7-2fa5c1bc0836": {
      "type": "featured-accordion",
      "blocks": {
        "entry_QJWLQm": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Why choose an OcuMow® robot mower?",
            "text": "<p>Save time mowing the lawn with OcuMow® robot mowers from LawnMaster®. Easy to use, they provide cutting-edge technology at an affordable price.     </p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
            "product_specifications": "",
