            "video_2": ""
          }
        },
        "entry_DK9RBg": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "What happens to the grass clippings?",
            "text": "<p>The grass is cut using three small sharp blades and the clippings are returned to the lawn surface where the nutrients contained in them fertilise the soil. This means stronger, healthier grass with less need for supplemental fertiliser and has the added bonus of helping the lawn retain water in dry periods. It also means no grass clippings to dispose of or compost. Provided that the mower is used regularly (i.e., once or twice a week) the clippings are not visible to the eye.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
