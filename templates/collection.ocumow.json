        "090a05a9-c530-405c-8480-12d5b201f814": {
          "type": "entry",
          "settings": {
            "full_width_enable": true,
            "title": "How do OcuMow® robot mowers work?",
            "text": "<p>LawnMaster OcuMow® <a href=\"/collections/lawnmaster-robot-lawnmowers\" title=\"Robot Lawn Mowers\">robot lawn mowers</a> use a camera combined with two ultrasonic sensors to navigate around your garden. The camera detects the difference between surface textures and colours, for example grass or paving, and the ultrasonic sensors detect obstacles higher than 6cm, such as plants, garden furniture, walls and fences meaning there is no need for a boundary wire.</p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
            "product_specifications": "",
            "html": "",
            "collection": "",
            "collection_products_per_page": 8,
            "products": [],
            "image_loading": "",
            "video_1": "",
            "video_2": ""
          }
        },
        "entry_YbYqtW": {
          "type": "entry",
          "settings": {
            "full_width_enable": false,
            "title": "Can OcuMow® robot mowers be used on any size of lawn?",
            "text": "<p>OcuMow® 16 robot mowers are designed for smaller lawns up to 100m2. OcuMow® 18 autocharging robot mowers are for any size lawn up to 800m2. </p>",
            "button_1_style": "white",
            "button_1_text": "",
            "button_1_url": "",
            "button_2_style": "white",
            "button_2_text": "",
            "button_2_url": "",
            "product_specifications": "",
